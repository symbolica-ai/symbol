#!/bin/sh
set -eu

SYMBOL_GENERATION_MODE='readonly'
export SYMBOL_GENERATION_MODE

require_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'optional host SDK tool %s is missing; run sh nix/check.sh for the canonical release gate\n' "$1" >&2
    exit 127
  fi
}

require_tool node
require_tool tsc
require_tool biome
require_tool uv

# nixpkgs only ships chromium for Linux, and the flake gates the browser smoke
# test on the same condition, so a missing chromium skips that one check here
# instead of failing the whole run.
skip_browser_smoke=
if [ -z "${CHROMIUM_BIN:-}" ]; then
  for candidate in chromium chromium-browser google-chrome; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      CHROMIUM_BIN=$(command -v "${candidate}")
      export CHROMIUM_BIN
      break
    fi
  done
  if [ -z "${CHROMIUM_BIN:-}" ]; then
    skip_browser_smoke=1
  fi
fi

# The Markdown page assets are fetched, not committed; a no-op when current.
python3 tooling/fetch_vendor.py
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
cargo test --workspace --all-targets --all-features --locked
cargo build --workspace --locked
node tests/sdk/mock-server.mjs
node tests/sdk/js/runtime.mjs
node tests/sdk/js/real.mjs
biome check --config-path=tooling/biome.json \
  static/api.ts tests/sdk/ts/*.ts \
  examples/annotation-site/app.js examples/annotation-site/styles.css
node --input-type=module --check < examples/annotation-site/app.js
node tests/sdk/ts/run.mjs
if [ -n "${skip_browser_smoke}" ]; then
  printf 'skipping browser smoke test: no chromium found and CHROMIUM_BIN unset; sh nix/check.sh covers it\n' >&2
else
  node tests/sdk/js/browser-smoke.mjs
fi
uv --project tooling run --frozen ruff check --config tooling/pyproject.toml static/api.py tests/sdk/py
uv --project tooling run --frozen ruff format --check --config tooling/pyproject.toml static/api.py tests/sdk/py
uv --project tooling run --frozen python tests/sdk/py/runtime.py
uv --project tooling run --frozen python tests/sdk/py/optional.py
uv --project tooling run --frozen python tests/sdk/py/real.py
uv --project tooling run --frozen python tests/manual_examples.py
sh -n static/symbol.sh
sh -n tests/symbol_client.sh
sh -n tests/alias_transfer_e2e.sh
sh -n tests/lifecycle_e2e.sh
sh -n tests/production_guard.sh
sh tests/production_guard.sh
python3 tests/public_api_freeze.py
python3 tests/api_contract.py
uv --project tooling run --frozen python tests/documentation_surface.py
python3 tests/command_matrix.py
tests/symbol_client.sh
sh tests/alias_transfer_e2e.sh
sh tests/lifecycle_e2e.sh
